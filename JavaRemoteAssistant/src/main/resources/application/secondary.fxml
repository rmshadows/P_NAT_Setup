<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" minWidth="208.0" spacing="10.0" styleClass="app-root" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.SecondaryController">
    <children>
        <Label styleClass="help-title" text="远程协助" />
        <Label fx:id="Help" alignment="TOP_LEFT" maxWidth="Infinity" prefHeight="420.0" styleClass="help-text" wrapText="true" />
        <Button fx:id="Back2main" maxWidth="Infinity" minHeight="32.0" onAction="#switchToPrimary" styleClass="btn-primary" text="返回" />
    </children>
    <padding>
        <Insets bottom="12.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</VBox>
